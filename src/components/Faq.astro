---
import { faqs, type FaqGroup } from '../lib/faq';
import { fill } from '../lib/plans';

interface Props { group: FaqGroup; heading?: string; id?: string }
const { group, heading = 'Questions owners ask', id = 'faq' } = Astro.props;
const items = faqs[group].map((f) => ({ q: fill(f.q), a: fill(f.a) }));

---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap narrow">
    <p class="eyebrow">FAQ</p>
    <h2 id={`${id}-h`}>{heading}</h2>
    <div class="faq">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    cursor: pointer; list-style: none;
    display: flex; justify-content: space-between; gap: 1rem; align-items: center;
    padding: 1.1rem 0; font: 600 1.15rem/1.3 var(--font-head);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; flex: none; display: grid; place-items: center;
    width: 1.8rem; height: 1.8rem; border-radius: 50%;
    border: 2px solid var(--brass); color: var(--brass-text); font: 700 1.1rem/1 var(--font-body);
  }
  details[open] summary::after { content: '−'; }
  details p { margin: 0 0 1.2rem; color: var(--ink-soft); max-width: 40rem; }
</style>
