---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .page-hero {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(to right, rgb(20 35 58 / 4.5%) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(20 35 58 / 4.5%) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  h1 { max-width: 48rem; }
</style>
