---
/** Benchmark disc mark + wordmark. Mark source: public/brand/mark.svg (keep in sync). */
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
---
<a href="/" class:list={['logo', { inverse }]} aria-label="Benchmark Digital, home">
  <svg class="mark" viewBox="0 0 64 64" width="40" height="40" aria-hidden="true">
    <circle cx="32" cy="32" r="30" fill="#c9973f" />
    <circle cx="32" cy="32" r="30" fill="none" stroke="#7a561b" stroke-width="2" />
    <circle cx="32" cy="32" r="22" fill="none" stroke="#14233a" stroke-width="3" />
    <path d="M17 30h30" stroke="#14233a" stroke-width="3.5" stroke-linecap="round" />
    <path d="M32 31l-7 12h14z" fill="#14233a" />
  </svg>
  <span class="word">Benchmark <span>Digital</span></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); }
  .logo.inverse { color: var(--on-ink); }
  .mark { flex: none; }
  .word { font: 700 1.3rem/1 var(--font-head); letter-spacing: -0.01em; white-space: nowrap; }
  .word span { color: var(--brass-text); }
  .inverse .word span { color: var(--brass); }
</style>
