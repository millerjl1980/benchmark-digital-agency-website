---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page doesn't exist." noindex>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">404</p>
      <h1>Off the map.</h1>
      <p class="lead">That page doesn't exist, or it moved.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Go home</a>
        <a class="btn btn--ghost" href="/free-scan">Get your free Maps scan</a>
      </div>
    </div>
  </section>
</Base>
